# Schema: schema.graphqls

scalar Time

enum CourseStatus {
  AVAILABLE
  UNAVAILABLE
  ENLISTED
}

enum DifficultyLevel {
  INTRODUCTION
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

type Course {
  id: ID!
  name: String!
  price: Float!
  duration: String!
  description: String!
  enrollees: Int!
  status: CourseStatus!
  difficulty: DifficultyLevel!
  instructor: String!
  createdAt: Time!
  updatedAt: Time!
  enrollments: [Enrollment!]!
}

type Enrollment {
  id: ID!
  course: Course!
  student: Student!    # Will be resolved from external service
  status: EnrollmentStatus!
  enrolledAt: Time!
  createdAt: Time!
  updatedAt: Time!
}

type Student{
  id: ID!
  name: String!
}

input CourseInput {
  name: String!
  price: Float!
  duration: String!
  description: String!
  status: CourseStatus!
  difficulty: DifficultyLevel!
  instructor: String!
}

input EnrollmentInput {
  courseId: ID!
  studentId: ID!     # Reference to external student ID
  status: EnrollmentStatus!
}

type Query {
  # Course queries
  courses: [Course!]!
  course(courseId: ID!): Course
  coursesByDifficulty(difficulty: DifficultyLevel!): [Course!]!
}

type Mutation {
  # Course mutations
  createCourse(input: CourseInput!): Course!
  updateCourse(id: ID!, input: CourseInput!): Course!
  deleteCourseByName(name: String!): Boolean!
}