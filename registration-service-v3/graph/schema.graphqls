enum RegistrationStatus {
  pending
  enrolled
  completed
  dropped
  failed
}

type Registration {
  id: ID!
  studentID: String!
  courseID: String!
  status: RegistrationStatus!
  enrolledAt: String!
  updatedAt: String!
}

type RegistrationBatchResult {
  created: [Registration!]!
  skippedCourseIDs: [String!]!
}

type Mutation {
  createRegistration(
    studentID: String!
    courseID: String!
    status: RegistrationStatus
  ): Registration!

  createRegistrations(
    studentID: String!
    courseIDs: [String!]!
    status: RegistrationStatus
  ): RegistrationBatchResult!

  updateRegistration(
    id: ID!
    studentID: String!
    courseID: String!
    status: RegistrationStatus!
  ): Registration!

  deleteRegistration(id: ID!): Boolean

  dropCourse(studentID: String!, courseID: String!): Registration!
  completeCourse(studentID: String!, courseID: String!): Registration!
}

type Query {
  registration(id: ID!): Registration
  registrations: [Registration]
  registrationsByStudent(studentID: String!): [Registration!]!
}

type Subscription {
    registrationAdded: Registration!
}